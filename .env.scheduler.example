# ==========================================
# AUTOMATED DATA REFRESH CONFIGURATION
# ==========================================
# Copy this file to .env and configure as needed
# These settings control the automated data refresh scheduler

# === CORE SCHEDULER SETTINGS ===
# Enable the automated data refresh scheduler
# Set to 'true' to enable automatic scheduling of data refresh operations
ENABLE_AUTO_REFRESH=true

# Scheduler timezone (defaults to America/New_York)
# Use standard timezone identifiers (e.g., "UTC", "America/Los_Angeles", "Europe/London")
SCHEDULER_TIMEZONE=America/New_York

# === JOB QUEUE INTEGRATION ===
# Enable job processor for background task execution
# This must be 'true' for the scheduler to work properly
ENABLE_JOB_PROCESSOR=true

# === DEFAULT SCHEDULE CONFIGURATIONS ===
# Each schedule can be individually enabled/disabled
# Set to 'false' to disable a specific schedule type

# Hourly broadcast metrics refresh (default: enabled)
# Updates sponsor visibility and TV coverage data every hour
ENABLE_HOURLY_BROADCAST_REFRESH=true

# Daily performance data refresh (default: enabled)
# Updates telemetry, lap times, and race performance data daily at 2 AM
ENABLE_DAILY_PERFORMANCE_REFRESH=true

# Daily financial data refresh (default: enabled)
# Updates contracts, budgets, and prize money data daily at 3 AM
ENABLE_DAILY_FINANCIAL_REFRESH=true

# Weekly comprehensive refresh (default: enabled)
# Full data refresh for all scrapers weekly on Sunday at 1 AM
ENABLE_WEEKLY_COMPREHENSIVE_REFRESH=true

# Race day intensive refresh (default: disabled)
# Frequent updates during race weekends (Friday-Sunday every 2 hours)
# Enable this for real-time race weekend coverage
ENABLE_RACE_DAY_REFRESH=false

# Cache warmup refresh (default: disabled)
# Morning cache warming before peak usage hours at 6:30 AM
# Enable this to improve API response times during peak hours
ENABLE_CACHE_WARMUP=false

# === SCRAPER-SPECIFIC SETTINGS ===
# Individual scraper type enablement
# These control which scrapers are available for scheduling

# Broadcast metrics scraper (sponsor visibility, TV coverage)
ENABLE_BROADCAST_SCRAPER=true

# Financial data scraper (contracts, budgets, ROI analysis)
ENABLE_FINANCIAL_SCRAPER=true

# Performance data scraper (telemetry, race performance)
ENABLE_PERFORMANCE_SCRAPER=true

# Complete ROI scraper (advanced analytics - resource intensive)
ENABLE_COMPLETE_ROI_SCRAPER=false

# === PERFORMANCE TUNING ===
# Maximum concurrent scraping operations
SCRAPE_CONCURRENCY=3

# Delay between scraping requests (milliseconds)
SCRAPE_DELAY=2000

# Maximum execution timeout for scheduled jobs (milliseconds)
# Default: 30 minutes (1800000ms)
SCHEDULER_JOB_TIMEOUT=1800000

# Maximum retry attempts for failed scheduled jobs
SCHEDULER_MAX_RETRIES=3

# === MONITORING AND LOGGING ===
# Enable detailed scheduler logging
SCHEDULER_VERBOSE_LOGGING=true

# Log scheduler statistics interval (minutes)
SCHEDULER_STATS_INTERVAL=60

# Enable scheduler performance monitoring
ENABLE_SCHEDULER_MONITORING=true

# === ERROR HANDLING ===
# Continue scheduling other jobs if one fails
SCHEDULER_CONTINUE_ON_ERROR=true

# Alert threshold for failed executions
SCHEDULER_FAILURE_ALERT_THRESHOLD=5

# === REDIS CONFIGURATION ===
# Redis settings for job queues (required for scheduler)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis key prefix for scheduler data
REDIS_SCHEDULER_PREFIX=apex:scheduler

# === DATABASE SETTINGS ===
# Database connection settings (required for data refresh)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apex_data
DB_USER=apex_user
DB_PASSWORD=

# Enable database connection pooling optimizations
DB_ENABLE_HEALTH_CHECK=true
DB_MAX_CONNECTIONS=50
DB_MIN_CONNECTIONS=5

# === EXAMPLE CUSTOM SCHEDULE ===
# You can define custom schedules programmatically or via CLI
# Example: Add a mid-day broadcast refresh
# pnpm run scheduler:add -n "midday-broadcast" -c "0 12 * * *" -s "broadcast-metrics" -p "normal"

# === PRODUCTION CONSIDERATIONS ===
# In production environments, consider:
# 1. Setting up monitoring alerts for failed schedules
# 2. Implementing authentication for admin endpoints
# 3. Using environment-specific Redis and database connections
# 4. Adjusting concurrency based on available resources
# 5. Setting up log rotation and retention policies

# === HEALTH CHECK ENDPOINTS ===
# The following endpoints are available when the scheduler is enabled:
# GET  /health/detailed          - Include scheduler status in health check
# GET  /admin/scheduler          - View scheduler statistics and schedules
# POST /admin/scheduler/trigger/:scheduleName - Manually trigger a schedule

# === CLI COMMANDS ===
# Manage schedules via command line:
# pnpm run scheduler:status      - View scheduler status
# pnpm run scheduler:list        - List all schedules
# pnpm run scheduler:health      - Run health check
# pnpm run scheduler:trigger <name> - Manually trigger a schedule
# pnpm run scheduler:enable <name>  - Enable a schedule
# pnpm run scheduler:disable <name> - Disable a schedule