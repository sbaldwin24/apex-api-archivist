{
	"author": "Sterling Baldwin",
	"dependencies": {
		"@apollo/server": "^5.0.0",
		"@as-integrations/express5": "^1.1.2",
		"@graphql-tools/schema": "^10.0.25",
		"aws-sdk": "^2.1692.0",
		"bcrypt": "^6.0.0",
		"body-parser": "^2.2.0",
		"bull": "^4.16.5",
		"cheerio": "^1.1.2",
		"commander": "^14.0.0",
		"cors": "^2.8.5",
		"crawl4ai": "^1.0.1",
		"dataloader": "^2.2.3",
		"dotenv": "^17.2.2",
		"express": "5.1.0",
		"express-rate-limit": "^8.1.0",
		"express-validator": "^7.2.1",
		"graphql": "^16.11.0",
		"graphql-redis-subscriptions": "^2.7.0",
		"graphql-subscriptions": "^3.0.0",
		"graphql-tag": "^2.12.6",
		"graphql-ws": "^6.0.0",
		"helmet": "^8.1.0",
		"https-proxy-agent": "^7.0.6",
		"ioredis": "^5.7.0",
		"jsonwebtoken": "^9.0.2",
		"pg": "^8.16.3",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"uuid": "^13.0.0",
		"vitest": "^3.2.4",
		"ws": "^8.18.3",
		"zod": "^4.1.5"
	},
	"description": "Data acquisition and API server for Apex Data.",
	"devDependencies": {
		"@biomejs/biome": "2.2.3",
		"@eslint/js": "^9.35.0",
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "24.3.1",
		"@types/pg": "^8.15.5",
		"@types/supertest": "^6.0.3",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/uuid": "^10.0.0",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.43.0",
		"@typescript-eslint/parser": "^8.43.0",
		"axios": "^1.11.0",
		"chalk": "^5.6.2",
		"editorconfig": "^3.0.1",
		"eslint": "^9.35.0",
		"eslint-config-biome": "^2.1.3",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.4",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "55.1.1",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-regexp": "^2.10.0",
		"eslint-plugin-security": "^3.0.1",
		"eslint-plugin-sonarjs": "3.0.5",
		"eslint-plugin-unicorn": "61.0.2",
		"jest": "^30.1.3",
		"jest-environment-node": "^30.1.2",
		"prettier": "^3.6.2",
		"supertest": "^7.1.4",
		"ts-jest": "^29.4.1",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.43.0"
	},
	"keywords": [
		"apex",
		"motorsports",
		"racing",
		"api",
		"scraper"
	],
	"license": "ISC",
	"lint-staged": {
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		],
		"*.{ts,js}": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"main": "dist/server.js",
	"name": "apex-data-api",
	"scripts": {
		"// === CONSOLIDATED SCRAPER COMMANDS ====": "",
		"// === DATABASE MIGRATION COMMANDS ====": "",
		"// === PNPM MANAGEMENT COMMANDS ====": "",
		"// === REDIS MANAGEMENT COMMANDS ====": "",
		"// === TESTING COMMANDS ====": "",
		"build": "tsc",
		"dev:api": "tsx watch src/server.ts",
		"format": "prettier --write 'src/**/*.{ts,js,json}' 'tests/**/*.{ts,js,json}' '*.{js,json,md}'",
		"format:check": "prettier --check 'src/**/*.{ts,js,json}' 'tests/**/*.{ts,js,json}' '*.{js,json,md}'",
		"lint": "eslint src tests --ext .ts --fix && prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
		"lint:check": "eslint src tests --ext .ts && prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
		"lint:fix": "eslint src tests --ext .ts --fix",
		"migrate": "tsx src/migrations/migration-cli.ts",
		"migrate:create": "pnpm migrate create",
		"migrate:down": "pnpm migrate down",
		"migrate:reset": "pnpm migrate reset",
		"migrate:status": "pnpm migrate status",
		"migrate:up": "pnpm migrate up",
		"pnpm:audit": "pnpm audit --audit-level moderate",
		"pnpm:audit:fix": "pnpm audit --fix",
		"pnpm:clean": "pnpm store prune && rm -rf node_modules && pnpm install",
		"pnpm:outdated": "pnpm outdated",
		"pnpm:update": "pnpm update",
		"pnpm:update:interactive": "pnpm update --interactive",
		"redis:cache": "tsx redis-manager.ts cache",
		"redis:clear-queues": "tsx redis-manager.ts clear-queues",
		"redis:flush-cache": "tsx redis-manager.ts flush-cache",
		"redis:monitor": "tsx redis-manager.ts monitor",
		"redis:queues": "tsx redis-manager.ts queues",
		"redis:restart": "tsx redis-manager.ts restart",
		"redis:start": "tsx redis-manager.ts start",
		"redis:status": "tsx redis-manager.ts status",
		"redis:stop": "tsx redis-manager.ts stop",
		"scrape": "tsx src/consolidated-scraper.ts",
		"scrape:broadcast": "tsx src/consolidated-scraper.ts broadcast-metrics",
		"scrape:list": "tsx src/consolidated-scraper.ts --list",
		"scrape:parallel": "tsx src/consolidated-scraper.ts --parallel --concurrency 2",
		"scrape:setup-schemas": "tsx src/consolidated-scraper.ts --setup-schemas",
		"scrape:validate": "tsx src/consolidated-scraper.ts --validate",
		"seed": "tsx src/migrations/seed-cli.ts",
		"seed:reset": "pnpm seed reset",
		"seed:rollback": "pnpm seed rollback",
		"seed:run": "pnpm seed run",
		"seed:status": "pnpm seed status",
		"start:api": "pnpm run build && node dist/server.js",
		"start:crawl4ai": "./start_server.sh",
		"start:scraper": "pnpm run build && node dist/consolidated-scraper.js",
		"test": "jest",
		"test:api": "jest --testPathPattern=tests/api",
		"test:ci": "jest --coverage --watchAll=false --ci",
		"test:clear-cache": "jest --clearCache",
		"test:coverage": "jest --coverage",
		"test:coverage:open": "jest --coverage && open coverage/lcov-report/index.html",
		"test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
		"test:integration": "jest --testPathPattern=tests/integration",
		"test:unit": "jest --testPathPattern=tests/(base|database|utils)",
		"test:watch": "jest --watch"
	},
	"type": "commonjs",
	"version": "1.0.0"
}
