# Apex Data API - Production Environment Variables
# Copy this to .env.prod and fill in with secure production values

# ============================================================================
# Database Configuration (Production)
# ============================================================================
POSTGRES_DB=apex_prod
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION
DATABASE_URL=postgresql://apex_user:CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION@postgres:5432/apex_prod

# ============================================================================
# Redis Configuration (Production)
# ============================================================================
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION@redis:6379/0

# ============================================================================
# Security Secrets (Production)
# ============================================================================
SESSION_SECRET=GENERATE_RANDOM_SESSION_SECRET_HERE_64_CHARS_MINIMUM
JWT_SECRET=GENERATE_RANDOM_JWT_SECRET_HERE_32_CHARS_MINIMUM

# ============================================================================
# External Services (Production)
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# ============================================================================
# SSL and Domain Configuration
# ============================================================================
DOMAIN_NAME=your-domain.com
SSL_EMAIL=your-email@domain.com

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
