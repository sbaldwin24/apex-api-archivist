# ==============================================================================
# APEX DATA API - Production Dockerfile
# ==============================================================================
# Multi-stage build for production deployment with Bull/Redis job queuing
# Resolves pnpm dependency issues by using npm for Bull packages
# ==============================================================================

# ==============================================================================
# Stage 1: Base Node.js Image with Dependencies
# ==============================================================================
FROM node:20-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    dumb-init \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    librsvg-dev \
    && rm -rf /var/cache/apk/*

# Create app directory with proper permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S apex -u 1001 && \
    mkdir -p /app && \
    chown -R apex:nodejs /app

WORKDIR /app
USER apex

# ==============================================================================
# Stage 2: Dependencies Installation
# ==============================================================================
FROM base AS dependencies

# Copy package files
COPY --chown=apex:nodejs package.json pnpm-lock.yaml ./
COPY --chown=apex:nodejs pnpm-workspace.yaml ./

# Install pnpm
RUN npm install -g pnpm@latest

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile --production=false

# Install Bull and Redis packages using npm to avoid resolution issues
RUN npm install --no-save \
    bull@^4.16.5 \
    ioredis@^5.7.0 \
    redis-errors@^1.2.0 \
    redis-parser@^3.0.0 \
    cluster-key-slot@^1.1.2 \
    standard-as-callback@^2.1.0

# ==============================================================================
# Stage 3: Build Stage
# ==============================================================================
FROM dependencies AS builder

# Copy source code
COPY --chown=apex:nodejs . .

# Build TypeScript application
RUN pnpm run build

# Clean up development dependencies
RUN pnpm prune --prod

# ==============================================================================
# Stage 4: Production Image
# ==============================================================================
FROM base AS production

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV ENABLE_JOB_PROCESSOR=true
ENV ENABLE_SOCIAL_MEDIA_SCRAPER=true
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379
ENV DB_HOST=postgres
ENV DB_PORT=5432

# Create necessary directories
RUN mkdir -p /app/logs /app/coverage /app/uploads && \
    chown -R apex:nodejs /app

# Copy built application from builder stage
COPY --from=builder --chown=apex:nodejs /app/dist ./dist/
COPY --from=builder --chown=apex:nodejs /app/node_modules ./node_modules/
COPY --from=builder --chown=apex:nodejs /app/package.json ./package.json

# Copy configuration files
COPY --from=builder --chown=apex:nodejs /app/*.sql ./
COPY --from=builder --chown=apex:nodejs /app/migrations ./migrations/
COPY --from=builder --chown=apex:nodejs /app/scrapers ./scrapers/

# Copy startup scripts
COPY --chown=apex:nodejs <<'EOF' /app/start.sh
#!/bin/sh
set -e

echo "🚀 Starting Apex Data API in production mode..."

# Wait for services to be ready
echo "⏳ Waiting for PostgreSQL..."
while ! nc -z ${DB_HOST} ${DB_PORT}; do
  sleep 1
done
echo "✅ PostgreSQL is ready"

echo "⏳ Waiting for Redis..."
while ! nc -z ${REDIS_HOST} ${REDIS_PORT}; do
  sleep 1
done
echo "✅ Redis is ready"

# Run database migrations
echo "📊 Running database migrations..."
npm run migrate:up

# Start the application
echo "🌟 Starting application..."
exec dumb-init node dist/server.js
EOF

# Copy job processor startup script
COPY --chown=apex:nodejs <<'EOF' /app/start-worker.sh
#!/bin/sh
set -e

echo "⚙️ Starting Apex Job Processor..."

# Wait for services to be ready
echo "⏳ Waiting for Redis..."
while ! nc -z ${REDIS_HOST} ${REDIS_PORT}; do
  sleep 1
done
echo "✅ Redis is ready"

# Start job processor
echo "🔄 Starting job processor..."
exec dumb-init node dist/queue/job-processor.js
EOF

# Copy scheduler startup script
COPY --chown=apex:nodejs <<'EOF' /app/start-scheduler.sh
#!/bin/sh
set -e

echo "⏰ Starting Apex Scheduler..."

# Wait for services to be ready
echo "⏳ Waiting for Redis..."
while ! nc -z ${REDIS_HOST} ${REDIS_PORT}; do
  sleep 1
done
echo "✅ Redis is ready"

# Start scheduler
echo "📅 Starting scheduler..."
exec dumb-init node dist/scheduler/integrated-scheduler.js
EOF

# Make scripts executable
RUN chmod +x /app/start.sh /app/start-worker.sh /app/start-scheduler.sh

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (res) => { \
        process.exit(res.statusCode === 200 ? 0 : 1); \
    }).on('error', () => { process.exit(1); });"

# Default command
CMD ["/app/start.sh"]

# Labels for image metadata
LABEL maintainer="Sterling Baldwin"
LABEL description="Apex Data API - Production Image with Bull/Redis Job Queuing"
LABEL version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/your-org/apex-api-archivist"