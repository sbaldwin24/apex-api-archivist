# ==============================================================================
# APEX DATA API - Production Environment Configuration
# ==============================================================================
# Copy this file to .env.production and update values for your environment
# ==============================================================================

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

DB_NAME=
DB_USER=
DB_PASSWORD=your_secure_database_password_here
DB_HOST=postgres
DB_PORT=
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=30000

# External database port (if accessing from outside Docker)
DB_EXTERNAL_PORT=

# ==============================================================================
# REDIS CONFIGURATION (Bull Queues)
# ==============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0

# External Redis port (if accessing from outside Docker)
REDIS_EXTERNAL_PORT=6379

# ==============================================================================
# BULL QUEUE PRODUCTION SETTINGS
# ==============================================================================

# Enable production queue manager and scheduler
ENABLE_PRODUCTION_QUEUES=true
ENABLE_PRODUCTION_SCHEDULER=true

# Queue concurrency settings (jobs processed simultaneously per queue)
SOCIAL_MEDIA_CONCURRENCY=2
BROADCAST_CONCURRENCY=1
FINANCIAL_CONCURRENCY=1
PERFORMANCE_CONCURRENCY=2

# ==============================================================================
# SCHEDULER CONFIGURATION
# ==============================================================================

# Enable/disable individual schedulers
ENABLE_SOCIAL_MEDIA_SCHEDULER=true
ENABLE_BROADCAST_SCHEDULER=true
ENABLE_FINANCIAL_SCHEDULER=true
ENABLE_PERFORMANCE_SCHEDULER=true
ENABLE_TRENDING_SCHEDULER=true

# ==============================================================================
# SCRAPER SETTINGS
# ==============================================================================

# General scraper settings
SCRAPE_CONCURRENCY=3
SCRAPE_DELAY=2000

# Enable/disable individual scrapers
ENABLE_SOCIAL_MEDIA_SCRAPER=true
ENABLE_BROADCAST_SCRAPER=true
ENABLE_FINANCIAL_SCRAPER=true
ENABLE_PERFORMANCE_SCRAPER=true

# ==============================================================================
# SOCIAL MEDIA API CREDENTIALS (Optional - for enhanced scraping)
# ==============================================================================

# Twitter/X API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# Instagram API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_CLIENT_ID=

# Facebook API
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=

# TikTok API
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=

# YouTube API
YOUTUBE_API_KEY=

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# JWT secret (change this!)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ==============================================================================
# MONITORING & UTILITIES
# ==============================================================================

# Redis Commander (for monitoring Redis)
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123
REDIS_COMMANDER_PORT=8081

# Bull Dashboard (for monitoring job queues)
BULL_DASHBOARD_PORT=3001

# API external port
API_EXTERNAL_PORT=3000

# ==============================================================================
# BACKUP SETTINGS
# ==============================================================================

# Database backup schedule (cron format)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ==============================================================================
# STORAGE DIRECTORIES
# ==============================================================================

# Base directories for data and logs
DATA_DIR=./data
LOGS_DIR=./logs
UPLOADS_DIR=./uploads

# ==============================================================================
# WORKER SCALING
# ==============================================================================

# Number of worker replicas (for scaling job processing)
WORKER_REPLICAS=2

# Job processing settings
JOB_CONCURRENCY=3
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================

# Default job priority (lower number = higher priority)
DEFAULT_JOB_PRIORITY=5

# Cron schedules for different scrapers (change as needed)
SOCIAL_MEDIA_CRON=0 */4 * * *      # Every 4 hours
BROADCAST_CRON=0 6 * * *           # Daily at 6 AM
FINANCIAL_CRON=0 2 * * 1           # Weekly Monday 2 AM
PERFORMANCE_CRON=0 4 * * *         # Daily at 4 AM

# ==============================================================================
# DEVELOPMENT/TESTING OVERRIDES
# ==============================================================================

# Uncomment these for development/testing with production setup
# NODE_ENV=development
# LOG_LEVEL=debug
# ENABLE_PRODUCTION_SCHEDULER=false
# SOCIAL_MEDIA_CONCURRENCY=1

# ==============================================================================
# OPTIONAL SERVICES
# ==============================================================================

# Crawl4AI service (for enhanced web scraping)
CRAWL4AI_BASE_URL=http://crawl4ai:8000
CRAWL4AI_PORT=8000

# Health check intervals (in seconds)
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
